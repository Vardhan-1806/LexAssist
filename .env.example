# Copy to .env for local development. Replace every placeholder.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000
TRUST_PROXY=1

# MongoDB local or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/lexassist

# Use independent random values (32+ characters) for both secrets.
# Example generator: node -p "require('crypto').randomBytes(48).toString('base64url')"
JWT_SECRET=replace_with_a_unique_random_value_of_at_least_32_characters
OTP_PEPPER=replace_with_a_different_unique_random_value_of_at_least_32_chars
JWT_EXPIRES_IN=7d
# Local-only code preview when SMTP is unavailable. Set false on Railway/hosted deploys.
ALLOW_DEV_OTP=true

# Persisted document storage. In production set this to the mounted persistent volume path.
UPLOAD_DIR=./uploads

# SMTP. Gmail requires an App Password; other SMTP providers can use these settings too.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-smtp-password

# Optional. Local RAG still works when this is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
AI_REQUESTS_PER_DAY=30

# Production startup is blocked until qualified counsel has reviewed every
# bundled/uploaded legal source and legal document template. Do not self-attest
# without completing that review.
LEGAL_CONTENT_REVIEWED=false
# LEGAL_CONTENT_REVIEW_DATE=YYYY-MM-DD
